{
  "manifest_version": 3,
  "name": "LABELSystem キャプション登録",
  "description": "Xで開いている投稿の表示名・ユーザーID・本文を、LABELSystem 用の Google スプレッドシートへ転記します。",
  "version": "2.1.1",

  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],

  "action": {
    "default_title": "キャプションへ登録",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "label-system@example.invalid",
      "strict_min_version": "115.0"
    }
  }
}
