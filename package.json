{
  "name": "label-system",
  "version": "2.1.0",
  "description": "LABELSystem - Layout and Artwork Bibliographic Entry Layer: フォトコンテスト用キャプション生成システム",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "蓼科千曲 / TATESHINA Chikuma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChikumaTateshina/LABELSystem.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "build": "node scripts/build-extension.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "check:private-data": "node scripts/check-private-data.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "fontkit": "^2.0.4",
    "pdfkit": "^0.15.2",
    "svg-to-pdfkit": "^0.1.8",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/fontkit": "^2.0.7",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.8",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "linkedom": "^0.18.13",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
